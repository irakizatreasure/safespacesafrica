# Set before first startup to create the initial CEO account.
SISP_ADMIN_EMAIL=ceo@example.org
SISP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-characters

# Local server binding. Use 127.0.0.1 for local-only use; put a TLS reverse proxy in front before public exposure.
SISP_HOST=127.0.0.1
SISP_PORT=8000
SISP_COOKIE_SECURE=false
SISP_DB_PATH=./data/sisp.sqlite3
# Set DATABASE_URL only when using a persistent Postgres host. Local use defaults to SQLite.
DATABASE_URL=

# Optional Cyizere AI. Keys stay server-side. The primary receives the request first;
# the fallback is tried only if the primary provider fails.
SISP_AI_PROVIDER=
SISP_AI_API_KEY=
SISP_AI_MODEL=
SISP_AI_FALLBACK_PROVIDER=
SISP_AI_FALLBACK_API_KEY=
SISP_AI_FALLBACK_MODEL=
# Choose openai, gemini, or claude for the primary and (optionally) a different fallback.
# Cyizere answers only from content that an authorized reviewer has approved and published.
